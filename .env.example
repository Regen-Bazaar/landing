# Telegram routing for Regen Bazaar forms.
# Set these in Vercel → Project → Settings → Environment Variables (NOT committed).
# Locally, copy to `.env` for `vercel dev`.

# Bot API token from @BotFather (keep secret; regenerate if ever exposed).
TELEGRAM_BOT_TOKEN=

# Investor enquiries (/api/contact) are DM'd here — your personal Telegram numeric user id.
TELEGRAM_OWNER_CHAT_ID=

# NGO applications (/api/apply) are posted to this group — numeric chat id, e.g. -1001234567890
TELEGRAM_GROUP_CHAT_ID=

# ...in this forum topic (message_thread_id), e.g. 23. Leave blank if the group has no topics.
TELEGRAM_TOPIC_ID=

# Comma-separated allowed Origins for the API (CSRF-lite). Use "*" to allow all.
ALLOWED_ORIGINS=https://regenbazaar.com,https://www.regenbazaar.com
